-- 01_funnel.sql
WITH user_stages AS (
    SELECT
        user_id,
        MAX(CASE WHEN event_name = 'Discovery' THEN 1 ELSE 0 END) AS discovery,
        MAX(CASE WHEN event_name = 'Search' THEN 1 ELSE 0 END) AS search,
        MAX(CASE WHEN event_name = 'PDP_View' THEN 1 ELSE 0 END) AS pdp_view,
        MAX(CASE WHEN event_name = 'Add_to_Cart' THEN 1 ELSE 0 END) AS add_to_cart,
        MAX(CASE WHEN event_name = 'Checkout_Start' THEN 1 ELSE 0 END) AS checkout_start,
        MAX(CASE WHEN event_name = 'Purchase' THEN 1 ELSE 0 END) AS purchase
    FROM ecommerce_events
    GROUP BY user_id
)
SELECT
    SUM(discovery) AS discovery_users,
    SUM(search) AS search_users,
    SUM(pdp_view) AS pdp_users,
    SUM(add_to_cart) AS cart_users,
    SUM(checkout_start) AS checkout_users,
    SUM(purchase) AS purchasers
FROM user_stages;

-- 02_stage_conversion.sql
WITH funnel AS (
    SELECT
        COUNT(DISTINCT CASE WHEN event_name = 'Discovery' THEN user_id END) AS discovery,
        COUNT(DISTINCT CASE WHEN event_name = 'Search' THEN user_id END) AS search,
        COUNT(DISTINCT CASE WHEN event_name = 'PDP_View' THEN user_id END) AS pdp,
        COUNT(DISTINCT CASE WHEN event_name = 'Add_to_Cart' THEN user_id END) AS cart,
        COUNT(DISTINCT CASE WHEN event_name = 'Checkout_Start' THEN user_id END) AS checkout,
        COUNT(DISTINCT CASE WHEN event_name = 'Purchase' THEN user_id END) AS purchase
    FROM ecommerce_events
)
SELECT
    discovery,
    search,
    ROUND(search * 100.0 / NULLIF(discovery, 0), 2) AS discovery_to_search,
    pdp,
    ROUND(pdp * 100.0 / NULLIF(search, 0), 2) AS search_to_pdp,
    cart,
    ROUND(cart * 100.0 / NULLIF(pdp, 0), 2) AS pdp_to_cart,
    checkout,
    ROUND(checkout * 100.0 / NULLIF(cart, 0), 2) AS cart_to_checkout,
    purchase,
    ROUND(purchase * 100.0 / NULLIF(checkout, 0), 2) AS checkout_to_purchase
FROM funnel;

-- 03_device_analysis.sql
SELECT
    device,
    COUNT(DISTINCT CASE WHEN event_name = 'Discovery' THEN user_id END) AS visitors,
    COUNT(DISTINCT CASE WHEN event_name = 'Add_to_Cart' THEN user_id END) AS cart_users,
    COUNT(DISTINCT CASE WHEN event_name = 'Checkout_Start' THEN user_id END) AS checkout_users,
    COUNT(DISTINCT CASE WHEN event_name = 'Purchase' THEN user_id END) AS purchasers,
    ROUND(
        COUNT(DISTINCT CASE WHEN event_name = 'Purchase' THEN user_id END) * 100.0 /
        NULLIF(COUNT(DISTINCT CASE WHEN event_name = 'Discovery' THEN user_id END), 0), 2
    ) AS purchase_conversion
FROM ecommerce_events
GROUP BY device
ORDER BY purchase_conversion DESC;

-- 04_customer_type.sql
